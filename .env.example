# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional publishable/anon key for the local draft prototype; caller JWT remains RLS-scoped.
SUPABASE_ANON_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_FOUNDER_USER_ID=

# GitHub
GITHUB_REPOSITORY=anupdalvi86-oss/sutra
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Model providers / Hermes
OPENAI_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
SUTRA_HERMES_API_ENABLED=false
API_SERVER_KEY=
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
HERMES_AGENT_API_URL=
HERMES_AGENT_API_KEY=
SUTRA_HERMES_PROVIDER=
SUTRA_HERMES_MODEL=
SUTRA_HERMES_ROLE_ROUTES={"architect":{"provider":"kimi-coding","model":"kimi-k2.6"},"devops":{"provider":"kimi-coding","model":"kimi-k2.6"}}

# Runtime
SUTRA_ENV=development
SUTRA_ENABLE_TELEGRAM=false
SUTRA_ENABLE_AGENT_WORKER=false
SUTRA_AGENT_WORKER_CONCURRENCY=2
SUTRA_ENABLE_GITHUB_DISPATCHER=false
SUTRA_ENABLE_CODEX_RUNNER=false
SUTRA_ENABLE_DRAFT_API=false
SUTRA_CODEX_PROVIDER=openai
SUTRA_CODEX_MODEL=gpt-6-luna
SUTRA_CODEX_BINARY=codex
SUTRA_INTERNAL_TOKEN=
HERMES_HEALTH_URL=
