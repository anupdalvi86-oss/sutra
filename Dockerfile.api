FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SUTRA_BIND_HOST=0.0.0.0

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git nodejs npm \
    && npm install --global @openai/codex@0.157.1 \
    && rm -rf /var/lib/apt/lists/ /root/.npm \
    && useradd --system --uid 10001 --home-dir /nonexistent --no-create-home sutra
COPY sutra /app/sutra
USER sutra
EXPOSE 8080
CMD ["python", "-m", "sutra.server"]
